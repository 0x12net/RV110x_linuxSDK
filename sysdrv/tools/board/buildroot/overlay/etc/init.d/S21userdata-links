#!/bin/sh
#
# userdata-links  Create symlinks from /etc (and other paths) to /userdata
#                 so configuration changes persist across firmware updates.
#

# make_link SRC DST
#   SRC: original file path (symlink will be placed here)
#   DST: persistent copy in /userdata
#
# First boot:  SRC renamed to SRC.orig, copied to DST, symlink created.
# Next boots:  SRC is already a symlink — nothing to do.
# Broken link: DST missing — restore from SRC.orig, recreate symlink.
make_link() {
	local src="$1"
	local dst="$2"
	local backup="${src}.orig"

	# Broken symlink: target missing — restore from .orig backup
	if [ -L "$src" ] && [ ! -e "$src" ]; then
		rm "$src"
		if [ -f "$backup" ]; then
			cp "$backup" "$dst"
		fi
		ln -sf "$dst" "$src"
		return
	fi

	# Not yet a symlink: rename original, copy to userdata, create link
	if [ ! -L "$src" ]; then
		if [ -e "$src" ]; then
			mv "$src" "$backup"
		fi
		if [ ! -f "$dst" ] && [ -f "$backup" ]; then
			cp "$backup" "$dst"
		fi
		ln -sf "$dst" "$src"
	fi
}

# make_link_dir SRC DST
#   Same as make_link but for directories.
make_link_dir() {
	local src="$1"
	local dst="$2"
	local backup="${src}.orig"

	# Broken symlink: target missing — recreate
	if [ -L "$src" ] && [ ! -e "$src" ]; then
		rm "$src"
		if [ -d "$backup" ] && [ ! -d "$dst" ]; then
			cp -a "$backup" "$dst"
		fi
		ln -sf "$dst" "$src"
		return
	fi

	# Not yet a symlink: rename original dir, create link
	if [ ! -L "$src" ]; then
		if [ -e "$src" ]; then
			mv "$src" "$backup"
		fi
		ln -sf "$dst" "$src"
	fi
}

# --- hostname ---
hostname_setup() {
	make_link /etc/hostname /userdata/hostname
}

# --- network/interfaces ---
network_setup() {
	make_link /etc/network/interfaces /userdata/network_interfaces
}

# --- ip6tables ---
ip6tables_setup() {
	make_link /etc/ip6tables.conf /userdata/ip6tables
}

# --- iptables ---
iptables_setup() {
	make_link /etc/iptables.conf /userdata/iptables
}

# --- shadow ---
shadow_setup() {
	make_link /etc/shadow /userdata/shadow
}

# --- ssh authorized_keys + host keys ---
ssh_setup() {
	UD=/userdata/ssh
	mkdir -p $UD
	chmod 700 $UD

	mkdir -p /root/.ssh/
	chmod 700 /root/.ssh/

	ln -sf $UD/authorized_keys /root/.ssh/authorized_keys

	ln -sf $UD/ssh_host_rsa_key /etc/ssh/ssh_host_rsa_key
	ln -sf $UD/ssh_host_ecdsa_key /etc/ssh/ssh_host_ecdsa_key
	ln -sf $UD/ssh_host_ed25519_key /etc/ssh/ssh_host_ed25519_key

	ln -sf $UD/ssh_host_rsa_key.pub /etc/ssh/ssh_host_rsa_key.pub
	ln -sf $UD/ssh_host_ecdsa_key.pub /etc/ssh/ssh_host_ecdsa_key.pub
	ln -sf $UD/ssh_host_ed25519_key.pub /etc/ssh/ssh_host_ed25519_key.pub
}

# --- tailscale ---
tailscale_setup() {
	UD=/userdata/tailscale
	mkdir -p $UD
	chmod 700 $UD

	make_link_dir /etc/tailscale $UD
}

# --- wpa_supplicant ---
wpa_supplicant_setup() {
	make_link /etc/wpa_supplicant.conf /userdata/wpa_supplicant.conf
}

# --- wireguard ---
wireguard_setup() {
	UD=/userdata/wireguard
	mkdir -p $UD
	chmod 700 $UD

	make_link_dir /etc/wireguard $UD
}

start() {
	shadow_setup
	hostname_setup
	network_setup
	ip6tables_setup
	iptables_setup
	ssh_setup
	tailscale_setup
	wireguard_setup
	wpa_supplicant_setup
}

case "$1" in
  start)
	start
	;;
  stop|restart|reload)
	;;
  *)
	echo "Usage: $0 {start|stop|restart}"
	exit 1
esac

exit 0
